@using ClinicBooking.Application.Common.DTOs
@model CreateDoctorDto
@{
    ViewData["Title"] = "Add Doctor";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h3 class="fw-bold mb-0">Add New Doctor</h3>
                <span class="text-muted small">Create doctor profile and authentication credentials</span>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-id-card text-primary me-2"></i>Account & Personal Details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control rounded-3 bg-light border-0 py-2" placeholder="e.g. Dr. Jane Smith" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-medium">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control rounded-3 bg-light border-0 py-2" type="email" placeholder="jane.smith@clinic.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-medium">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3 bg-light border-0 py-2" placeholder="+1234567890" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-medium">Temporary Password <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control rounded-3 bg-light border-0 py-2" type="password" placeholder="At least 8 chars, uppercase & special" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-hospital-user text-primary me-2"></i>Practice Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ConsultationFee" class="form-label fw-medium">Consultation Fee (EGP / ج.م) <span class="text-danger">*</span></label>
                            <input asp-for="ConsultationFee" class="form-control rounded-3 bg-light border-0 py-2" type="number" step="0.01" min="0" placeholder="e.g. 300.00" />
                            <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AppointmentDurationMinutes" class="form-label fw-medium">Slot Duration (Minutes)</label>
                            <input asp-for="AppointmentDurationMinutes" class="form-control rounded-3 bg-light border-0 py-2" type="number" min="10" max="120" step="5" />
                            <span asp-validation-for="AppointmentDurationMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClinicName" class="form-label fw-medium">Clinic Name</label>
                            <input asp-for="ClinicName" class="form-control rounded-3 bg-light border-0 py-2" placeholder="e.g. Downtown Medical Suite" />
                            <span asp-validation-for="ClinicName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClinicAddress" class="form-label fw-medium">Clinic Address</label>
                            <input asp-for="ClinicAddress" class="form-control rounded-3 bg-light border-0 py-2" placeholder="e.g. 123 Main St, Suite 400" />
                            <span asp-validation-for="ClinicAddress" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Bio" class="form-label fw-medium">Doctor Bio & Qualifications</label>
                            <textarea asp-for="Bio" class="form-control rounded-3 bg-light border-0" rows="3" placeholder="Brief professional background, certifications, and experience..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Specialties</label>
                            <select asp-for="SpecialtyIds" asp-items="ViewBag.Specialties" class="form-select rounded-3 bg-light border-0" multiple style="min-height: 120px;"></select>
                            <small class="text-muted"><i class="fa-solid fa-circle-info me-1"></i> Hold Ctrl (or Cmd on Mac) to select multiple specialties.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-user-plus me-2"></i> Create Doctor Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
