@model IEnumerable<ClinicBooking.Web.ViewModels.Admin.DoctorListViewModel>
@{
    ViewData["Title"] = "Doctors Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-dark"><i class="fa-solid fa-user-doctor text-primary me-2"></i>Doctors</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm px-4">
        <i class="fa-solid fa-plus me-1"></i> Add New Doctor
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Doctor Info</th>
                        <th>Specialties</th>
                        <th>Fee (EGP)</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 45px; height: 45px;">
                                            <i class="fa-solid fa-user-md fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.FullName</div>
                                            <div class="small text-muted">@item.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Specialties.Any())
                                    {
                                        foreach (var spec in item.Specialties)
                                        {
                                            <span class="badge bg-secondary rounded-pill me-1 fw-normal">@spec</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Specialties</span>
                                    }
                                </td>
                                <td class="fw-medium text-dark">@item.ConsultationFee ج.م</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 rounded-pill fw-medium">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 rounded-pill fw-medium">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @if (item.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Are you sure you want to deactivate this doctor? Inactive doctors cannot receive new bookings.');">
                                                <i class="fa-solid fa-ban me-1"></i> Suspend
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="return confirm('Are you sure you want to activate this doctor?');">
                                                <i class="fa-solid fa-check me-1"></i> Activate
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div class="fs-1 text-light mb-3"><i class="fa-solid fa-folder-open"></i></div>
                                <h5>No Doctors Found</h5>
                                <p>Doctors registered in the system will appear here.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

