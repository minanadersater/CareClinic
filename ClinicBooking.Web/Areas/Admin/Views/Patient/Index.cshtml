@using ClinicBooking.Application.Common.DTOs
@model IReadOnlyList<PatientDto>
@{
    ViewData["Title"] = "Patients Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-dark"><i class="fa-solid fa-users text-primary me-2"></i>Patients</h2>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Patient Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Date of Birth</th>
                        <th>Appointments</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="fw-bold text-dark">@p.FullName</div>
                                    </div>
                                </td>
                                <td>@p.Email</td>
                                <td>@p.PhoneNumber</td>
                                <td>@(p.DateOfBirth?.ToString("MMM dd, yyyy") ?? "—")</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-dark px-3 rounded-pill fw-medium">
                                        @p.AppointmentCount visits
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="fa-solid fa-eye me-1"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="fs-1 text-light mb-3"><i class="fa-solid fa-folder-open"></i></div>
                                <h5>No Patients Found</h5>
                                <p>Patients who register will appear in this directory.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
