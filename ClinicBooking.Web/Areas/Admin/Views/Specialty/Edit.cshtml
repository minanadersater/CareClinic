@model ClinicBooking.Web.ViewModels.Admin.SpecialtyViewModel
@{
    ViewData["Title"] = "Edit Specialty";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <h3 class="fw-bold mb-0">Edit Specialty</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-medium"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control rounded-3 bg-light border-0" placeholder="Cardiology" />
                        <label asp-for="Name">Specialty Name <span class="text-danger">*</span></label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control rounded-3 bg-light border-0" style="height: 120px" placeholder="Details..."></textarea>
                        <label asp-for="Description">Description</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="isActiveSwitch">
                        <label class="form-check-label fw-medium ms-2" for="isActiveSwitch">Is Active?</label>
                        <small class="d-block text-muted mt-1">Inactive specialties cannot be assigned to new doctors.</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-check-double me-2"></i> Update Specialty
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

