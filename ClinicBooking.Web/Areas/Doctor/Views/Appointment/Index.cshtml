@using ClinicBooking.Application.Common.DTOs
@model IReadOnlyList<AppointmentDto>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-dark"><i class="fa-solid fa-calendar-check text-primary me-2"></i>My Appointments</h2>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Patient</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var a in Model.OrderByDescending(x => x.AppointmentDate).ThenBy(x => x.StartTime))
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 38px; height: 38px;">
                                            <i class="fa-solid fa-user-injured"></i>
                                        </div>
                                        <div class="fw-bold text-dark">@a.PatientName</div>
                                    </div>
                                </td>
                                <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-medium text-primary">@a.StartTime.ToString(@"hh\:mm") – @a.EndTime.ToString(@"hh\:mm")</td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-2 @(a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Pending ? "bg-warning text-dark" :
                                                         a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Confirmed ? "bg-primary text-white" :
                                                         a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Completed ? "bg-success text-white" : "bg-danger text-white")">
                                        @a.Status
                                    </span>
                                </td>
                                <td><span class="text-truncate d-inline-block text-muted" style="max-width: 180px;">@a.PatientNotes</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3 me-1">
                                        <i class="fa-solid fa-eye me-1"></i> Details
                                    </a>
                                    @if (a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Pending)
                                    {
                                        <form asp-action="Confirm" asp-route-id="@a.Id" method="post" class="d-inline">
                                            <button class="btn btn-sm btn-success rounded-pill px-3 me-1">
                                                <i class="fa-solid fa-check me-1"></i> Confirm
                                            </button>
                                        </form>
                                    }
                                    @if (a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Confirmed)
                                    {
                                        <form asp-action="Complete" asp-route-id="@a.Id" method="post" class="d-inline">
                                            <button class="btn btn-sm btn-primary rounded-pill px-3 me-1">
                                                <i class="fa-solid fa-circle-check me-1"></i> Complete
                                            </button>
                                        </form>
                                    }
                                    @if (a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Completed)
                                    {
                                        <a asp-area="Doctor" asp-controller="MedicalRecord" asp-action="Create"
                                           asp-route-patientId="@a.PatientId" asp-route-appointmentId="@a.Id"
                                           class="btn btn-sm btn-outline-info rounded-pill px-3 me-1">
                                            <i class="fa-solid fa-file-medical me-1"></i> Add Record
                                        </a>
                                    }
                                    @if (a.Status != ClinicBooking.Domain.Enums.AppointmentStatus.Cancelled && a.Status != ClinicBooking.Domain.Enums.AppointmentStatus.Completed)
                                    {
                                        <form asp-action="Cancel" method="post" class="d-inline">
                                            <input type="hidden" name="AppointmentId" value="@a.Id" />
                                            <input type="hidden" name="CancellationReason" value="Doctor cancelled" />
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                                <i class="fa-solid fa-xmark me-1"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="fs-1 text-light mb-3"><i class="fa-solid fa-calendar-xmark"></i></div>
                                <h5>No Appointments Scheduled</h5>
                                <p>You have no appointments on record.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
