@using ClinicBooking.Application.Common.DTOs
@model IReadOnlyList<AppointmentDto>
@{
    ViewData["Title"] = "My Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-dark"><i class="fa-solid fa-calendar-check text-primary me-2"></i>My Appointments</h2>
    <a asp-area="Patient" asp-controller="Booking" asp-action="SelectDoctor" class="btn btn-primary rounded-pill shadow-sm px-4">
        <i class="fa-solid fa-plus me-1"></i> Book New Appointment
    </a>
</div>

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted">
                    <tr>
                        <th class="ps-4">Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 38px; height: 38px;">
                                            <i class="fa-solid fa-user-md"></i>
                                        </div>
                                        <div class="fw-bold text-dark">Dr. @a.DoctorName</div>
                                    </div>
                                </td>
                                <td>@a.AppointmentDate.ToString("MMM dd, yyyy")</td>
                                <td class="fw-medium text-primary">@a.StartTime.ToString(@"hh\:mm") – @a.EndTime.ToString(@"hh\:mm")</td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-2 @(a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Pending ? "bg-warning text-dark" :
                                                         a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Confirmed ? "bg-primary text-white" :
                                                         a.Status == ClinicBooking.Domain.Enums.AppointmentStatus.Completed ? "bg-success text-white" : "bg-danger text-white")">
                                        @a.Status
                                    </span>
                                </td>
                                <td><span class="text-truncate d-inline-block text-muted" style="max-width: 200px;">@a.PatientNotes</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                        <i class="fa-solid fa-eye me-1"></i> Details
                                    </a>
                                    @if (a.Status != ClinicBooking.Domain.Enums.AppointmentStatus.Cancelled && a.Status != ClinicBooking.Domain.Enums.AppointmentStatus.Completed)
                                    {
                                        <form asp-action="Cancel" method="post" class="d-inline">
                                            <input type="hidden" name="AppointmentId" value="@a.Id" />
                                            <input type="hidden" name="CancellationReason" value="Cancelled by patient" />
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="return confirm('Are you sure you want to cancel this appointment?')">
                                                <i class="fa-solid fa-xmark me-1"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="fs-1 text-light mb-3"><i class="fa-solid fa-calendar-xmark"></i></div>
                                <h5>No Appointments Found</h5>
                                <p>You have not booked any appointments yet.</p>
                                <a asp-area="Patient" asp-controller="Booking" asp-action="SelectDoctor" class="btn btn-primary rounded-pill px-4 mt-2">
                                    Book Your First Appointment
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
