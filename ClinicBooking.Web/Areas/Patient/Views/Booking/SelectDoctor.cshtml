@model IEnumerable<ClinicBooking.Domain.Entities.Doctor>
@{
    ViewData["Title"] = "Select Doctor";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="fw-bold text-dark"><i class="fa-solid fa-stethoscope text-primary me-2"></i>Find a Doctor</h2>
</div>

<div class="row">
    @if (Model != null && Model.Any())
    {
        foreach (var doctor in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 feature-card text-center p-4">
                    <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mx-auto mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="fa-solid fa-user-doctor"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Dr. @doctor.FullName</h5>
                    <p class="text-muted small mb-2">
                        @if (doctor.DoctorSpecialties != null && doctor.DoctorSpecialties.Any())
                        {
                            @string.Join(", ", doctor.DoctorSpecialties.Select(ds => ds.Specialty?.Name))
                        }
                        else
                        {
                            <span>General Practitioner</span>
                        }
                    </p>
                    <div class="fw-bold text-success mb-3">@doctor.ConsultationFee ج.م (EGP) <span class="text-muted fw-normal small">/ visit</span></div>
                    
                    <a asp-action="SelectSlot" asp-route-doctorId="@doctor.Id" class="btn btn-outline-primary rounded-pill w-100 fw-medium mt-auto">
                        <i class="fa-solid fa-calendar-check me-2"></i> View Availability
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <h4 class="text-muted">No active doctors found at the moment.</h4>
        </div>
    }
</div>

