@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="text-danger mb-4">
                <i class="fa-solid fa-shield-halved" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">You do not have the required permissions to access this page or resource.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow-sm">
                    <i class="fa-solid fa-house me-2"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>
