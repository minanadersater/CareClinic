@model ClinicBooking.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                <div class="fs-1 mb-2"><i class="fa-solid fa-key"></i></div>
                <h4 class="mb-0 fw-bold">Forgot Password</h4>
                <small class="text-white-50">We'll email you a link to reset it</small>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                @if (TempData["ResetEmailSent"] != null)
                {
                    <div class="alert alert-success rounded-3 small" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        If an account exists for that email, a password reset link has been sent.
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-medium"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Email" class="form-control rounded-3 bg-light border-0" placeholder="name@example.com" />
                        <label asp-for="Email"><i class="fa-regular fa-envelope me-2 text-muted"></i>Email address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm">
                        Send reset link <i class="fa-solid fa-paper-plane ms-2"></i>
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-0">
                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to sign in
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
