@model ClinicBooking.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                <div class="fs-1 mb-2"><i class="fa-solid fa-user-lock"></i></div>
                <h4 class="mb-0 fw-bold">Welcome Back</h4>
                <small class="text-white-50">Sign in to your CareClinic account</small>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-medium"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3 bg-light border-0" placeholder="name@example.com" />
                        <label asp-for="Email"><i class="fa-regular fa-envelope me-2 text-muted"></i>Email address</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control rounded-3 bg-light border-0" placeholder="Password" />
                        <label asp-for="Password"><i class="fa-solid fa-lock me-2 text-muted"></i>Password</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input shadow-none" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small">Remember me</label>
                        </div>
                        <a href="#" class="small text-decoration-none text-primary fw-medium">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm">
                        Sign In <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-0">
                <span class="text-muted small">Don't have an account?</span>
                <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">Register Now</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

