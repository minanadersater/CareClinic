@model ClinicBooking.Web.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white text-center py-4 border-0">
                <div class="fs-1 mb-2"><i class="fa-solid fa-user-plus"></i></div>
                <h4 class="mb-0 fw-bold">Create an Account</h4>
                <small class="text-white-50">Join CareClinic to book your appointments</small>
            </div>
            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-medium"></div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-floating">
                                <input asp-for="FullName" class="form-control rounded-3 bg-light border-0" placeholder="John Doe" />
                                <label asp-for="FullName"><i class="fa-regular fa-user me-2 text-muted"></i>Full Name</label>
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Email" class="form-control rounded-3 bg-light border-0" placeholder="name@example.com" />
                                <label asp-for="Email"><i class="fa-regular fa-envelope me-2 text-muted"></i>Email</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="PhoneNumber" class="form-control rounded-3 bg-light border-0" placeholder="Phone Number" />
                                <label asp-for="PhoneNumber"><i class="fa-solid fa-phone me-2 text-muted"></i>Phone</label>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-floating">
                                <input asp-for="DateOfBirth" type="date" class="form-control rounded-3 bg-light border-0" />
                                <label asp-for="DateOfBirth"><i class="fa-solid fa-calendar-day me-2 text-muted"></i>Date of Birth</label>
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Password" class="form-control rounded-3 bg-light border-0" placeholder="Password" />
                                <label asp-for="Password"><i class="fa-solid fa-lock me-2 text-muted"></i>Password</label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control rounded-3 bg-light border-0" placeholder="Confirm Password" />
                                <label asp-for="ConfirmPassword"><i class="fa-solid fa-lock-open me-2 text-muted"></i>Confirm Password</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm">
                        Create Account <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3 border-0">
                <span class="text-muted small">Already have an account?</span>
                <a asp-action="Login" class="text-primary fw-bold text-decoration-none ms-1">Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

