@model ClinicBooking.Web.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5">
            <div class="text-danger mb-4">
                <i class="fa-solid fa-triangle-exclamation" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Oops! Something went wrong</h2>
            <p class="text-muted mb-4">An unexpected error occurred while processing your request.</p>
            
            @if (Model.ShowRequestId)
            {
                <div class="p-3 bg-light rounded-3 mb-4 text-start">
                    <small class="text-muted d-block fw-bold">Request ID</small>
                    <code class="text-primary">@Model.RequestId</code>
                </div>
            }

            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow-sm">
                    <i class="fa-solid fa-house me-2"></i> Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>
